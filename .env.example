# Voom Nexus — Environment Configuration Template
# IMPORTANT: Never commit actual production secrets to version control.
# Copy this file to .env or .env.local and populate with your local values.

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# Web Application URL (for CORS and redirects)
WEB_APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://voom_user:voom_password@localhost:5432/voom_nexus?schema=public

# Authentication & JWT Configuration
JWT_SECRET=replace_with_a_secure_cryptographic_random_string_at_least_32_bytes
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_a_different_random_string_at_least_32_bytes
REFRESH_TOKEN_EXPIRES_IN=7d

# CLI Cloud Sync (Optional)
VOOM_API_ENDPOINT=http://localhost:4000/api/v1
VOOM_API_TOKEN=placeholder_user_cli_token

# Redis Cache & Background Queue (Optional / Phase 5)
REDIS_URL=redis://localhost:6379

# Storage for Reports / Artifacts
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./.voomsec/storage

