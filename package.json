{
  "name": "voom-nexus",
  "version": "0.1.0-alpha.0",
  "description": "Voom Nexus — AI-Aware Application Security Platform (Vibe Security Tool)",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "./node_modules/.bin/tsc -b",
    "typecheck": "./node_modules/.bin/tsc -b --noEmit",
    "test": "node --test packages/*/test/*.test.js apps/*/test/*.test.js",
    "clean": "rm -rf packages/*/dist apps/*/dist"
  },
  "keywords": [
    "security",
    "sast",
    "application-security",
    "vibe-coding",
    "owasp",
    "cwe",
    "ai-security",
    "devsecops"
  ],
  "author": "Voom Nexus Team",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.2"
  }
}
